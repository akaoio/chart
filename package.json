{
    "name": "@akaoio/chart",
    "version": "0.0.0",
    "description": "Financial charts as plain Web Components — a port of react-financial-charts",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/akaoio/chart.git"
    },
    "homepage": "https://akaoio.github.io/chart/",
    "bugs": "https://github.com/akaoio/chart/issues",
    "keywords": [
        "chart",
        "charts",
        "candlestick",
        "financial",
        "stockcharts",
        "trading",
        "web-components",
        "custom-elements",
        "canvas",
        "d3"
    ],
    "exports": {
        ".": "./src/index.js",
        "./*": "./src/*"
    },
    "files": [
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "test": "npm run test:golden && npm run test:browser",
        "golden": "TZ=UTC node --import ./tools/golden/resolve-source.mjs tools/golden/generate.mjs",
        "test:browser": "node test.browser.js",
        "test:golden": "TZ=UTC node test.js"
    },
    "dependencies": {
        "d3-array": "^3.2.4",
        "d3-force": "^3.0.0",
        "d3-format": "^3.1.0",
        "d3-interpolate": "^3.0.1",
        "d3-path": "^3.1.0",
        "d3-scale": "^4.0.2",
        "d3-shape": "^3.2.0",
        "d3-time": "^3.1.0",
        "d3-time-format": "^4.1.0"
    },
    "devDependencies": {
        "playwright": "^1.60.0"
    }
}
